<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path
        name="external_files"
        path="." />
    <!-- app-specific external files dir: where direct-install APKs are downloaded -->
    <external-files-path
        name="external_files_app"
        path="." />
    <!-- app cache: file_picker caches picked files here when the original
         content URI has no resolvable direct file path -->
    <cache-path
        name="cache"
        path="." />
    <files-path
        name="files"
        path="." />
</paths>
